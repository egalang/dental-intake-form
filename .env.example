# Public registration API base URL used by the browser.
#
# Leave EMPTY (recommended) to call the API on the same origin as this form.
# The Vite dev server proxies /api, and the bundled nginx config reverse-proxies
# /api in production, so no CORS configuration is required on the API.
#
# Set an absolute URL only if the form must call the API cross-origin and that
# API sends the appropriate CORS headers.
VITE_REGISTRATION_API_URL=
